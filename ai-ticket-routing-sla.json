    {
      "parameters": {
        "sendTo": "director@company.example",
        "subject": "=[ESCALATION L2] {{ $json.priority }} ticket — {{ $json.subject }}",
        "message": "=<h2>Ескалація L2 — Director</h2>\n<p>Тікет <strong>{{ $json.priority }}</strong> прострочено на <strong>{{ $json.minutes_overdue }} хв</strong>. Власник {{ $json.owner }} і тімлід не зреагували.</p>\n<h3>Контекст</h3>\n<ul>\n<li><strong>Категорія:</strong> {{ $json.category }}</li>\n<li><strong>Sentiment:</strong> {{ $json.sentiment }}</li>\n<li><strong>Від:</strong> {{ $json.from_email }}</li>\n<li><strong>Створено:</strong> {{ $json.created_at }}</li>\n</ul>\n<h3>Резюме</h3>\n<p>{{ $json.summary }}</p>\n<h3>AI Reasoning</h3>\n<p><em>{{ $json.reasoning }}</em></p>\n<p><a href=\"{{ $json.thread_link }}\">→ Відкрити thread</a></p>",
        "options": {}
      },
      "id": "3c64dde9-cf8d-4ad1-b5df-016af3f63506",
      "name": "Email: Director (L2)",
