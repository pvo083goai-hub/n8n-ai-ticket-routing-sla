      "id": "a2b84314-4d10-4a2e-9cd5-107ffff33a1e",
      "name": "Flatten Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        -352,
        544
      ],
      "notes": "Збирає всі поля для логування та маршрутизації в один плоский об'єкт. SLA deadline розраховується = created_at + sla_minutes."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-not-spam",
              "leftValue": "={{ $json.parsed.category }}",
              "rightValue": "spam",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3c1e7fc7-755d-4eef-bfa8-377e14456047",
      "name": "Не спам?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -128,
        544
      ],
      "notes": "Захист бюджету: спам не йде далі. Логуємо тільки осмислені тікети."
