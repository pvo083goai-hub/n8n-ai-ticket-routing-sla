          "combinator": "and"
        },
        "options": {}
      },
      "id": "a648d2b7-997c-408d-9448-324ba6177821",
      "name": "SLA Breached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -704,
        1072
      ],
      "notes": "Якщо deadline < now і тікет ще open — breach."
    },
    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "escalation_level",
              "type": "numberValue",
              "numberValue": "={{ (() => { const overdueMin = DateTime.now().diff(DateTime.fromISO($json.sla_deadline), 'minutes').minutes; if (overdueMin < 30) return 0; if (overdueMin < 60) return 1; return 2; })() }}"
            },
            {
              "name": "minutes_overdue",
              "type": "numberValue",
              "numberValue": "={{ Math.round(DateTime.now().diff(DateTime.fromISO($json.sla_deadline), 'minutes').minutes) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b036286c-a981-4e3e-9ff2-8d2054123dde",
      "name": "Compute Escalation Level",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        -480,
        1072
      ],
      "notes": "Рахуємо рівень ескалації:\n- Level 0: breach 0–30 хв → пінг власнику\n- Level 1: 30–60 хв → пінг тімліду\n- Level 2: 60+ хв → ескалація директору (email)"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "id": "lvl0",
                    "leftValue": "={{ $json.escalation_level }}",
                    "rightValue": 0,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Level 0 — Owner"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "id": "lvl1",
                    "leftValue": "={{ $json.escalation_level }}",
                    "rightValue": 1,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Level 1 — TL"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "id": "lvl2",
                    "leftValue": "={{ $json.escalation_level }}",
                    "rightValue": 2,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Level 2 — Director"
            }
          ]
        },
        "options": {}
      },
      "id": "247aac64-1b37-4b43-87be-b87953910dd1",
      "name": "Switch by Level",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        -256,
